{% set galleryTitle = entry.title ?? null %}
{% set galleryImages = entry.imageGallery ?? null %}
{% set count = count ?? '-1' %}

{% if galleryImages|length > 1 %}
    <div id="carouselIndicators" class="carousel slide my-24" data-bs-ride="carousel">
        <div class="carousel-indicators d-none d-lg-flex">
            {% for image in galleryImages %}
            {% set count = count + 1 %}
                <button type="button" data-bs-target="#carouselIndicators" data-bs-slide-to="{{count}}" {{loop.index == 1 ? 'class="active" aria-current="true"' : ''}} aria-label="Slide{{count}}"></button>
            {% endfor %}

        </div>
        <div class="carousel-inner">
            {% for image in galleryImages %}
                <div class="carousel-item {{loop.index == 1 ? 'active' : ''}} position-relative">

                    <img src="{{image.getUrl('galleryImage') ?? null}}" class="object-fit__cover d-block w-100 h-100" loading="lazy" height="600" alt="{{image.title ?? null}}">
                </div>
            {% endfor %}
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#carouselIndicators" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselIndicators" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
{% else %}
    {% for image in galleryImages %}
            <img src="{{image.getUrl('galleryImage') ?? null}}" class="object-fit__cover d-block w-100 my-24" height="500" alt="{{image.title ?? null}}">
    {% endfor %}
{% endif %}
